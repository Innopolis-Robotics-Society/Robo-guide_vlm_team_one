# Профиль: Gemma 4 E2B (Q4_K_M + mmproj-F16) — пилотная baseline-модель.
# См. guide_robot_llm/docs/pilot_skillset_and_vlm_candidates.md (Part B).
# Скопировать строки поверх одноимённых в .env.
# x86 dev: GPU со свободными ~6GB+.
# Jetson Orin (unified 7.4GB): CTX_SIZE=2048, CACHE_TYPE_K/V=q8_0, N_GPU_LAYERS —
# как в .env.jetson.example (см. jetson-профили), MM_PROJ тот же.
# Корень весов: относительный путь; на машине с другим раскладом —
# env-переменная MODELS_DIR (см. run_matrix.py::models_dir).
MODELS_DIR=models/pilot
MODEL_FILE=gemma4-e2b/gemma-4-E2B-it-Q4_K_M.gguf
MODEL_ALIAS=gemma-4-e2b-it-q4_k_m
MM_PROJ=gemma4-e2b/mmproj-F16.gguf
# Gemma 4 по умолчанию жрёт max_tokens в reasoning_content; для action-фазы
# (max_tokens_action=96) thinking обязателен к отключению.
REASONING=off
CTX_SIZE=16384
# Детерминизм кампаний: фиксированный сид llama-server (см. guide_robot_llm/docs/model_provenance.md).
SEED=42
