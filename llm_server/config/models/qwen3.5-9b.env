# Профиль: Qwen3.5-9B (Q4_K_M + mmproj-F16) — кандидат матрицы Taiga #11
# (верхняя полка открытых VLM на 24GB-карте; сравнение с Qwen3.5-4B).
# См. guide_robot_llm/docs/pilot_skillset_and_vlm_candidates.md (Part B).
# Скопировать строки поверх одноимённых в .env.
# x86 dev: GPU со свободными ~9GB+ (матричный драйвер сам поднимает сервер).
# Jetson Orin (unified 7.4GB): CTX_SIZE=2048 — не пройдёт, 9B только x86.
# Корень весов: относительный путь; на машине с другим раскладом —
# env-переменная MODELS_DIR (см. run_matrix.py::models_dir).
MODELS_DIR=models/pilot
MODEL_FILE=qwen3.5-9b/Qwen3.5-9B-Q4_K_M.gguf
MODEL_ALIAS=qwen3.5-9b-q4_k_m
MM_PROJ=qwen3.5-9b/mmproj-F16.gguf
# Qwen3.5 (как и Gemma 4) может уводить max_tokens в reasoning_content —
# thinking отключаем (матрица #11: детерминизм, temp 0).
REASONING=off
CTX_SIZE=16384
# Детерминизм кампаний: фиксированный сид llama-server (см. guide_robot_llm/docs/model_provenance.md).
SEED=42
