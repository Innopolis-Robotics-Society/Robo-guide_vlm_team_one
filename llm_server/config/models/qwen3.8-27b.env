# Профиль: Qwen3.8-27B (UD-IQ4_XS + mmproj-BF16) — production-модель,
# матричная прогонка Taiga #16 P7 (18 промпт-вариантов на pv_matrix_57:
# bench_50 + audience_engagement = 57 кейсов).
# Драйвер: guide_robot_llm/scripts/run_matrix.py --config scripts/matrix_pv16.json.
# Веса лежат на верхнем уровне MODELS_DIR (без подкаталога модели) + mmproj
# в qwen3.8-27B/ — пути собираются как MODELS_DIR/<файл>.
# Корень весов: относительный путь; на машине с другим раскладом —
# env-переменная MODELS_DIR (см. run_matrix.py::models_dir).
MODELS_DIR=models
MODEL_FILE=Qwen3.8-27B-UD-IQ4_XS.gguf
MODEL_ALIAS=qwen3.8-27b-ud-iq4_xs
MM_PROJ=qwen3.8-27B/mmproj-BF16.gguf
# Как и в матрице #11: thinking отключаем. Граница — бюджет генерации раннера
# 512 токенов (thinking-токены входят в бюджет и срезают ответ → parse_failed);
# плюс детерминизм. temperature задаёт сам раннер (0.2).
REASONING=off
CTX_SIZE=16384
